# Copy this file to .env and adjust values as needed.
# docker-compose reads this file automatically.

# --- Database ---
DB_NAME=subscription_manager
DB_USERNAME=subscription_manager
DB_PASSWORD=subscription_manager
DB_ROOT_PASSWORD=root
DB_PORT=3306

# --- Backend ---
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Auth ---
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Notifications & reminders ---
RENEWAL_REMINDER_DAYS=7
TRIAL_REMINDER_DAYS=3
NOTIFICATIONS_SCHEDULER_INITIAL_DELAY_MS=10000
NOTIFICATIONS_SCHEDULER_INTERVAL_MS=86400000

# --- Usage insights ---
RARELY_USED_DAYS=30
